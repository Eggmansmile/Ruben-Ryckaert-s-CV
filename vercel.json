{
  "buildCommand": "npm install",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "SMTP_SERVICE": "@smtp_service",
    "SMTP_USER": "@smtp_user",
    "SMTP_PASSWORD": "@smtp_password",
    "RECIPIENT_EMAIL": "@recipient_email"
  }
}
